# Copier en .env.local — ne jamais commiter le fichier rempli.

# Publiques : embarquées dans le bundle navigateur. Rien de sensible ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur uniquement. Lues dans la DAL et les handlers, jamais ailleurs.
# SUPABASE_SERVICE_ROLE_KEY bypasse toute la RLS : ne l'ajouter que si une tâche
# d'administration l'exige vraiment, et jamais dans un composant.
SUPABASE_SERVICE_ROLE_KEY=
